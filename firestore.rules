rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Simplified development rules:
    // - Any authenticated user can read/write clinic, doctor, queue, and patient documents.
    // - Public (unauthenticated) read access to high-level clinic & doctor metadata and queue metadata (GET only) is allowed.
    // WARNING: These rules are NOT suitable for production. Add role-based / field-level restrictions before launch.

    match /clinics/{clinicId} {
      allow read: if true;              // Public can read clinic info
      allow write: if request.auth != null;  // Any authed user can modify

      match /doctors/{doctorId} {
        allow read: if true;           // Public doctor info
        allow write: if request.auth != null;

        match /queues/{queueId} {
          allow get: if true;          // Public can fetch queue metadata (e.g., current token)
          allow read, write: if request.auth != null; // All other queue ops require auth

          match /patients/{patientId} {
            allow read, write: if request.auth != null; // Auth required for any patient access (broad during dev)
          }
        }
      }
    }

    // User profile docs: allow user to manage their own document. No staff/admin concept here.
    match /users/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false; // Prevent enumeration
    }
  }
}
