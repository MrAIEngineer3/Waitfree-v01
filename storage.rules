rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to manage their own profile images under users/{uid}/...
    match /users/{userId}/{allPaths=**} {
      allow read: if true; // Public can read profile images
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default (production-leaning behavior)
    match /{path=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
